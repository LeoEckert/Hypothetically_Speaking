# LLM provider — there is deliberately no platform-held key here for
# production: every user brings their own via the frontend's required
# onboarding popup (OpenRouter — no credit card needed, openrouter.ai/keys —
# or their own Anthropic key). OPENROUTER_API_KEY/ANTHROPIC_API_KEY below are
# a LOCAL-DEV CONVENIENCE ONLY, so you don't have to paste a key into
# Settings every run — don't set these in a production deployment's env; an
# operator who wants an optional platform key anyway can set one through the
# admin dashboard instead (backend/agent/admin.py).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FAST_MODEL=
ANTHROPIC_API_KEY=

# Tool keys — all optional. Every tool degrades to a mock/heuristic result
# without one; a user can also supply their own via Settings (BYOK) per run.
# Only Tavily has a real always-free tier; Amass has none; Nebius is used
# only for gene-NER quality (extract_genes falls back to a regex heuristic).
TAVILY_API_KEY=
AMASS_API_KEY=
NEBIUS_API_KEY=

# Optional pricing config — leave unset and the corresponding cost figures
# stay explicitly "unpriced" (rate_configured: false) rather than guessing;
# see backend/agent/costs.py. OpenRouter's own cost row is always $0/free_tier
# — no rate to configure there.
NEBIUS_PRICE_PER_1M_INPUT=
NEBIUS_PRICE_PER_1M_OUTPUT=
AMASS_PRICE_PER_CREDIT=
TAVILY_USD_PER_CALL=

# Admin dashboard (see docs/DEPLOY.md "Admin dashboard" section) — of
# shrinking relevance now that Anthropic is BYOK-only; see backend/server/app.py.
ADMIN_TOKEN=
ANTHROPIC_ADMIN_KEY=
ADMIN_OVERRIDES_PATH=

# CORS / tool config — defaults are usually fine for local dev
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=
ENABLED_TOOLS=

# Run budget — defaults are sized for a hard 300s external platform ceiling
# (Vercel Fluid Compute); see backend/agent/loop.py.
MAX_TOOL_CALLS=
MAX_RUN_SECONDS=
