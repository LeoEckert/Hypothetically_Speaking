# --- Anthropic (agent brain) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Tavily (live web/paper/trial/news retrieval) ---
TAVILY_API_KEY=

# --- Amass (scientific memory: literature, trials, patents, bio data) ---
AMASS_API_URL=https://api.amass.tech/api/v1
AMASS_API_KEY=

# --- Nebius (Token Factory hosted open model, used for gene/entity extraction) ---
# TODO confirm exact base URL / model id against credentials issued at the event
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_API_KEY=
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# --- Which tools the agent is allowed to call this run ---
# Comma-separated tool names. Remove one to test "switch a tool off".
# Options: tavily,amass,open_targets,pubmed,clinicaltrials,genage_drugage,run_enrichment,extract_genes
ENABLED_TOOLS=tavily,amass,open_targets,pubmed,clinicaltrials,genage_drugage,run_enrichment,extract_genes

# --- Agent run budget ---
MAX_TOOL_CALLS=15
MAX_RUN_SECONDS=1080

# --- Dev convenience: "development" pre-fills the demo question in the UI ---
APP_ENV=development

# --- CORS: which frontend origin(s) may call this API ---
# ALLOWED_ORIGINS is a comma-separated exact-match list (defaults cover the
# Vite dev/preview servers). ALLOWED_ORIGIN_REGEX additionally matches Vercel
# preview deployments, which get a fresh hostname per branch/commit.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app$

# --- Cost/usage tracking: per-unit prices for providers without a public,
# stable per-token/per-call rate. Leave blank to show usage counts without a
# dollar estimate (never guessed) — fill in your actual plan's rate to see $.
NEBIUS_PRICE_PER_1M_INPUT=
NEBIUS_PRICE_PER_1M_OUTPUT=
AMASS_PRICE_PER_CREDIT=
TAVILY_USD_PER_CALL=
